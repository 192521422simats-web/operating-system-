#include <stdio.h>
int main() {
    int n, bt[20], pr[20], rt[20];
    int wt[20], tat[20];
    int completed = 0, time = 0, min_pr, shortest;
    printf("Enter number of processes: ");
    scanf("%d", &n);
    for(int i = 0; i < n; i++) {
        printf("Burst Time of P%d: ", i + 1);
        scanf("%d", &bt[i]);
        printf("Priority of P%d: ", i + 1);
        scanf("%d", &pr[i]);
        rt[i] = bt[i];
    }
    while(completed < n) {
        min_pr = 9999;
        shortest = -1;
        for(int i = 0; i < n; i++) {
            if(rt[i] > 0 && pr[i] < min_pr) {
                min_pr = pr[i];
                shortest = i;
            }
        }
        rt[shortest]--;
        time++;
        if(rt[shortest] == 0) {
            completed++;
            tat[shortest] = time;
            wt[shortest] = tat[shortest] - bt[shortest];
        }
    }
    printf("\nProcess\tBT\tPriority\tWT\tTAT\n");
    for(int i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t\t%d\t%d\n",
               i + 1, bt[i], pr[i], wt[i], tat[i]);
    }
    return 0;
}
